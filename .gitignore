/build/
/dist/
*.spec

# Python
__pycache__/
*.pyc

# Runtime data (machine-specific; regenerated on first run)
backend/data/library_cache.json
backend/data/library_meta.json
backend/data/exports/*.wav
backend/data/projects/*.json

# OS cruft
Thumbs.db
.DS_Store
